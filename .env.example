# Le nom et le serveur Neon Auth sont publics. Cette URL n’est pas un secret.
VITE_NEON_AUTH_URL=https://ep-cool-pine-bav7txar.neonauth.c-8.eu-central-1.aws.neon.tech/formulaire_de_singe/auth

# Variables strictement côté serveur sur Netlify (ne pas préfixer VITE_).
NEON_AUTH_URL=https://ep-cool-pine-bav7txar.neonauth.c-8.eu-central-1.aws.neon.tech/formulaire_de_singe/auth
NEON_AUTH_JWKS_URL=https://ep-cool-pine-bav7txar.neonauth.c-8.eu-central-1.aws.neon.tech/formulaire_de_singe/auth/.well-known/jwks.json
DATABASE_URL=

# Étape 6 : non utilisés pour le moment.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Phase 3 : le MCP utilise le JWT signé de Neon Auth, comme l'API REST.
# Les identifiants ne sont jamais transmis dans le dépôt.
# R2 est privé : créer une clé limitée au bucket, jamais VITE_R2_*.
# R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY et R2_BUCKET_NAME
# sont nécessaires à l'étape 6 en production.

# Étape 9 : ressource OAuth2.1 MCP ; URL publique, pas un secret.
MCP_RESOURCE=https://formulaire-de-singe.netlify.app/mcp
PUBLIC_SITE_ORIGIN=https://formulaire-de-singe.netlify.app
